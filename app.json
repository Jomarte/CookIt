{
  "expo": {
    "name": "CookIt",
    "slug": "cookit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-new.png",
    "scheme": "cookit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.leitaonatario.cookit",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-new.png",
        "backgroundColor": "#FBF5EF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.cookit.app",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c11fa2e2-d05e-4995-84c4-6ef9b7b22667"
      }
    },
    "owner": "jomarte99"
  }
}
